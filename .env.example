# ============================================================================
# Modelo de variáveis de ambiente. Copie para .env e ajuste os valores.
# O .env está no .gitignore e no .dockerignore: nunca versione credenciais reais.
# ============================================================================

# Banco criado pelo serviço postgresql do docker-compose
POSTGRES_DB=irrigation_db

# Credenciais do banco. O compose usa os mesmos valores para criar o usuário do
# PostgreSQL e para a aplicação se conectar.
SPRING_DATASOURCE_USERNAME=irrigation
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# URL usada apenas ao rodar a aplicação fora do Docker (gradlew bootRun).
# No compose ela é substituída pelo host interno "postgresql".
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/irrigation_db

# Portas publicadas no host (opcionais)
POSTGRES_PORT=5432
APP_PORT=8080
