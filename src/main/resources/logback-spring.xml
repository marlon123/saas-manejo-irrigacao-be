<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging: JSON estruturado por padrão (Req 9.4). No perfil "dev" usa o formato legível
  padrão do Spring Boot para facilitar o desenvolvimento local.
  Níveis por pacote continuam configuráveis em application*.yml (logging.level.*).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="logback-json.xml"/>

    <appender name="PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="PLAIN"/>
        </root>
    </springProfile>

    <springProfile name="!dev">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
